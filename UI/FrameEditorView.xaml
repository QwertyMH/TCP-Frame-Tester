<UserControl x:Class="SimuladorTCP.UI.FrameEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="800">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,4" CornerRadius="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tramas configuradas" FontWeight="Bold" FontSize="14" 
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="btnAdd" Content="+ Agregar" Width="90" Height="28" Margin="0,0,4,0"
                         Style="{StaticResource SecondaryButton}" FontSize="11" Click="BtnAdd_Click"/>
                <Button x:Name="btnDelete" Content="X Eliminar" Width="90" Height="28"
                        Style="{StaticResource DangerButton}" FontSize="11" Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Margin="0,4" Padding="8">
            <DataGrid x:Name="dgvFrames" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      CanUserResizeColumns="True" CanUserSortColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}" 
                      VerticalGridLinesBrush="Transparent"
                      CellEditEnding="DgvFrames_CellEditEnding"
                      CurrentCellChanged="DgvFrames_CurrentCellChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N" Binding="{Binding Number}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="140"/>
                    <DataGridComboBoxColumn Header="Formato" SelectedItemBinding="{Binding Format}" Width="70">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="system:String" xmlns:system="clr-namespace:System;assembly=mscorlib">
                                <system:String>ASCII</system:String>
                                <system:String>HEX</system:String>
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn Header="Contenido" Binding="{Binding Content}" Width="*"/>
                    <DataGridTextColumn Header="Retardo (ms)" Binding="{Binding DelayMs}" Width="90"/>
                    <DataGridCheckBoxColumn Header="Activa" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTemplateColumn Header="Accion" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Enviar" Width="65" Height="24" FontSize="11"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSendCell_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,4" CornerRadius="0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSendSelected" Content="Enviar seleccionada" Width="135" Height="28" Margin="0,0,4,0"
                        Style="{StaticResource PrimaryButton}" FontSize="11" Click="BtnSendSelected_Click"/>
                <Button x:Name="btnSendAllActive" Content="Enviar activas" Width="110" Height="28" Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButton}" FontSize="11" Click="BtnSendAllActive_Click"/>
                <Button x:Name="btnSendLoop" Content="Enviar en bucle" Width="110" Height="28" Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButton}" FontSize="11" Click="BtnSendLoop_Click"/>
                <Button x:Name="btnStopLoop" Content="Detener bucle" Width="110" Height="28" Margin="0,0,4,0"
                        Style="{StaticResource DangerButton}" FontSize="11" Click="BtnStopLoop_Click" IsEnabled="False"/>
                <Button x:Name="btnClearLog" Content="Limpiar log" Width="100" Height="28" Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButton}" FontSize="11" Click="BtnClearLog_Click"/>
                <TextBlock x:Name="lblStatus" Text="Listo" FontWeight="Bold" FontSize="12" 
                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
