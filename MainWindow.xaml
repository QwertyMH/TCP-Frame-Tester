<Window x:Class="SimuladorTCP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:SimuladorTCP.UI"
        mc:Ignorable="d"
        Title="Simulador TCP/IP - Pruebas PLC" 
        Height="800" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="Archivo">
                <MenuItem Header="Guardar configuración" Click="OnSaveConfig" InputGestureText="Ctrl+G"/>
                <MenuItem Header="Cargar configuración" Click="OnLoadConfig" InputGestureText="Ctrl+C"/>
                <Separator/>
                <MenuItem Header="Salir" Click="OnExit"/>
            </MenuItem>
        </Menu>

        <!-- SplitContainer: Tabs arriba, Frame Editor abajo -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>

            <!-- Tabs -->
            <TabControl Grid.Row="0" Background="{StaticResource BackgroundBrush}" BorderThickness="0">
                <TabItem Header="TCP Client">
                    <ui:TcpClientView x:Name="ClientView" Margin="0"/>
                </TabItem>
                <TabItem Header="TCP Server">
                    <ui:TcpServerView x:Name="ServerView" Margin="0"/>
                </TabItem>
                <TabItem Header="Acerca de">
                    <Grid Background="{StaticResource BackgroundBrush}">
                        <TextBlock Text="Simulador TCP/IP para pruebas con PLCs&#x0a;&#x0a;Version: 1.0.0&#x0a;Desarrollado en C# / WPF"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Separador -->
            <Grid Grid.Row="1" Height="12" Background="{StaticResource BackgroundBrush}"/>

            <!-- Frame Editor -->
            <ui:FrameEditorView x:Name="FrameEditor" Grid.Row="2" Margin="0"/>
        </Grid>
    </Grid>
</Window>
